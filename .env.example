# Copy values into Azure App Service > Settings > Environment variables.
# Do not commit a connection string or a real secret.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
STORAGE_BACKEND=azure
AZURE_STORAGE_CONTAINER=studyboard
AZURE_STORAGE_BLOB=board.json
# Option 1: connection string, configured only in Azure/local environment.
AZURE_STORAGE_CONNECTION_STRING=
# Option 2: managed identity + Storage Blob Data Contributor role.
AZURE_STORAGE_ACCOUNT_URL=
COOKIE_SECURE=true

